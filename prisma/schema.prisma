generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum CertificateType {
  CURSO
  FORMACAO
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  password   String
  role       Role        @default(USER)
  avatar_url String?
  bio        String?
  api_keys   ApiKey[]
  portfolios Portfolio[]
  blogs      Blog[]
  projects   Project[]
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
}

model ApiKey {
  id          String   @id @default(uuid())
  user_id     String
  key         String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Portfolio {
  id          String             @id @default(uuid())
  user_id     String
  title       String
  subtitle    String?
  hero        Hero?
  about       About?
  projects    PortfolioProject[]
  experiences Experience[]
  socials     SocialLink[]
  pages       Page[]
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ---------- HERO SECTION ----------
model Hero {
  id           String   @id @default(uuid())
  portfolio_id String   @unique
  name         String
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  portfolio    Portfolio  @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  technologies HeroTech[]
}

// ---------- ABOUT SECTION ----------
model About {
  id           String   @id @default(uuid())
  portfolio_id String   @unique
  title        String
  subtitle     String?
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  portfolio    Portfolio   @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  technologies AboutTech[]
}

// ---------- PROJECTS ----------
model Project {
  id          String   @id @default(uuid())
  user_id     String
  slug        String
  title       String
  description String?
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user         User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  technologies ProjectTech[]
  portfolios   PortfolioProject[]

  @@unique([user_id, slug])
}

// ---------- EXPERIENCES ----------
model Experience {
  id           String   @id @default(uuid())
  portfolio_id String
  title        String
  subtitle     String?
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  portfolio    Portfolio     @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  companies    Company[]
  certificates Certificate[]
}

// ---------- COMPANIES ----------
model Company {
  id            String    @id @default(uuid())
  experience_id String
  name          String
  role_name     String
  image_url     String?
  date_start    DateTime
  date_end      DateTime?
  description   String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  experience   Experience    @relation(fields: [experience_id], references: [id], onDelete: Cascade)
  technologies CompanyTech[]
}

// ---------- CERTIFICATES ----------
model Certificate {
  id            String          @id @default(uuid())
  experience_id String
  slug          String
  name          String
  type          CertificateType
  image_url     String?
  hours         Int?
  date_end      DateTime?
  description   String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  experience Experience @relation(fields: [experience_id], references: [id], onDelete: Cascade)

  @@unique([experience_id, slug])
}

// ---------- SOCIAL LINKS ----------
model SocialLink {
  id           String   @id @default(uuid())
  portfolio_id String
  name         String
  url          String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
}

// ---------- PORTFOLIO x PROJECT (MANY-TO-MANY) ----------
model PortfolioProject {
  id           String   @id @default(uuid())
  portfolio_id String
  project_id   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([portfolio_id, project_id])
}

// ---------- PAGES (DINÂMICAS) ----------
model Page {
  id           String   @id @default(uuid())
  portfolio_id String
  slug         String
  title        String
  content      Json?
  published    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@unique([portfolio_id, slug])
}

model Blog {
  id         String     @id @default(uuid())
  user_id    String
  title      String
  subtitle   String?
  posts      Post[]
  categories Category[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(uuid())
  blog_id     String
  category_id String?
  slug        String
  title       String
  description String?
  image_url   String?
  content     Json?
  published   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  blog     Blog      @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [category_id], references: [id])

  @@unique([blog_id, slug])
}

model Category {
  id         String   @id @default(uuid())
  blog_id    String
  name       String
  slug       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  blog  Blog   @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([blog_id, slug])
}

model Technology {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  hero_techs    HeroTech[]
  about_techs   AboutTech[]
  project_techs ProjectTech[]
  company_techs CompanyTech[]
}

// Tabelas pivot para relacionamentos N:N
model HeroTech {
  hero_id       String
  technology_id String

  hero       Hero       @relation(fields: [hero_id], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technology_id], references: [id], onDelete: Cascade)

  @@id([hero_id, technology_id])
}

model AboutTech {
  about_id      String
  technology_id String

  about      About      @relation(fields: [about_id], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technology_id], references: [id], onDelete: Cascade)

  @@id([about_id, technology_id])
}

model ProjectTech {
  project_id    String
  technology_id String

  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technology_id], references: [id], onDelete: Cascade)

  @@id([project_id, technology_id])
}

model CompanyTech {
  company_id    String
  technology_id String

  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technology_id], references: [id], onDelete: Cascade)

  @@id([company_id, technology_id])
}
